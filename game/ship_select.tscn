[ext_resource type="Texture2D" path="res://assets/ui/chevron-right.svg" id="7_next"]

[sub_resource type="ButtonGroup" id="HullChoices"]

[sub_resource type="Gradient" id="Gradient_side"]
offsets = PackedFloat32Array(0.0, 0.2, 0.42)
colors = PackedColorArray(0.012, 0.025, 0.05, 0.9, 0.012, 0.025, 0.05, 0.72, 0.012, 0.025, 0.05, 0)

[sub_resource type="GradientTexture2D" id="SideShade"]
gradient = SubResource("Gradient_side")
width = 256
height = 16
fill_to = Vector2(1, 0)

[sub_resource type="Gradient" id="Gradient_floor"]
offsets = PackedFloat32Array(0.0, 0.5)
colors = PackedColorArray(0.012, 0.025, 0.05, 0.85, 0.012, 0.025, 0.05, 0)

[sub_resource type="GradientTexture2D" id="FloorShade"]
gradient = SubResource("Gradient_floor")
width = 16
height = 256
fill_from = Vector2(0, 1)
fill_to = Vector2(0, 0)

[node name="ShipSelect" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1_menu")

[node name="SideShade" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = SubResource("SideShade")
expand_mode = 1

[node name="FloorShade" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = SubResource("FloorShade")
expand_mode = 1

[node name="PreviewArea" type="ReferenceRect" parent="."]
unique_name_in_owner = true
anchor_left = 0.3
anchor_top = 0.09
anchor_right = 0.95
anchor_bottom = 0.68
mouse_filter = 2
border_color = Color(0.37, 0.88, 1, 0.25)

[node name="Wordmark" type="Label" parent="."]
oversampling_with_scale = true
theme_type_variation = &"LaunchWordmark"
text = "DELTA WARP"

[node name="Status" type="HBoxContainer" parent="."]
mouse_filter = 2
theme_override_constants/separation = 36

[node name="Best" type="HBoxContainer" parent="Status"]
